    "success_A = motifA_df_agg[(motifA_df_agg[\"motifRMSD_mean_unbound\"] <= 1.0) & (motifA_df_agg[\"motifRMSD_mean_bound\"] > 1.0) & ((motifA_df_agg[\"motifRMSD_mean_bound\"] - motifA_df_agg[\"motifRMSD_mean_unbound\"]).abs() >= 0.5)] # motif A active in state 0, inactive in state 1\n",
